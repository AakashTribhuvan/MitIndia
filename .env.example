# Frontend settings live in app/frontend/.env.example (Vite reads that folder).

# Backend (app/backend) settings, all optional:
# MUDRA_PORT=8000                      # backend port (also set VITE_API_URL in app/frontend/.env)
# MUDRA_MODEL_DIR=app/backend/models/isl_mudra_combined_v6_bilstm
# MUDRA_DEVICE=cpu                      # or cuda
# MUDRA_UNCERTAIN_THRESHOLD=0.95        # overrides the validation-chosen threshold in model_card.json
# MUDRA_MIN_HAND_RATE=0.3               # below this share of frames with hands, report no_hands
# MUDRA_CORS_ORIGINS=https://your-site.example
