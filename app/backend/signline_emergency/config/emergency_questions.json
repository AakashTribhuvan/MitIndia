{
  "version": 1,
  "_comment": "Only questions that change the report or the next action. 'only_if' conditions: no_location, answer:<KEY>=<VALUE>, missing_signal:<SIGN>.",
  "max_pending": 2,
  "questions": {
    "HELP_TYPE": {"text": "What kind of help do you need?", "answer_type": "SINGLE_CHOICE", "priority": 95,
                  "options": [["MEDICAL", "Medical"], ["POLICE_SAFETY", "Police or safety"], ["FIRE", "Fire"],
                              ["GENERAL_ACCIDENT", "Accident"], ["TRAPPED", "Rescue"], ["GENERAL_HELP", "Something else"]],
                  "reason": "Only 'help' was reported; the kind of help decides who is needed."},
    "IMMEDIATE_DANGER": {"text": "Are you in immediate danger?", "answer_type": "YES_NO_NOT_SURE", "priority": 90,
                         "options": [["YES", "Yes"], ["NO", "No"], ["NOT_SURE", "Not sure"]],
                         "reason": "Tells responders how urgent this is."},
    "PEOPLE_TRAPPED": {"text": "Is anyone trapped?", "answer_type": "YES_NO_NOT_SURE", "priority": 85,
                       "options": [["YES", "Yes"], ["NO", "No"], ["NOT_SURE", "Not sure"]],
                       "reason": "Changes the rescue needed."},
    "WHO_AFFECTED": {"text": "Are you describing yourself or another person?", "answer_type": "SINGLE_CHOICE", "priority": 70,
                     "options": [["SELF", "Myself"], ["OTHER", "Another person"]],
                     "reason": "Responders need to know who needs help."},
    "ANYONE_UNCONSCIOUS": {"text": "Is anyone unconscious?", "answer_type": "YES_NO_NOT_SURE", "priority": 80,
                           "options": [["YES", "Yes"], ["NO", "No"], ["NOT_SURE", "Not sure"]],
                           "only_if": ["answer:WHO_AFFECTED=OTHER"],
                           "reason": "Asked only when the help is for someone else."},
    "ANYONE_INJURED": {"text": "Is anyone injured?", "answer_type": "YES_NO_NOT_SURE", "priority": 75,
                       "options": [["YES", "Yes"], ["NO", "No"], ["NOT_SURE", "Not sure"]],
                       "only_if": ["missing_signal:INJURY"],
                       "reason": "Asked only if an injury was not already reported."},
    "LOCATION": {"text": "Where should responders find you?", "answer_type": "SINGLE_CHOICE", "priority": 40,
                 "options": [["SHARE", "Share my location"], ["ENTER", "Type a location"]],
                 "only_if": ["no_location"], "reason": "Asked only when no location has been shared."},
    "LOCATION_SAFE": {"text": "Can you safely share your location?", "answer_type": "SINGLE_CHOICE", "priority": 60,
                      "options": [["SHARE", "Share my location"], ["ENTER", "Type a location"]],
                      "only_if": ["no_location"], "reason": "Optional: sharing is only done if it is safe for you."}
  }
}
