{
  "version": 1,
  "_comment": "Deterministic emergency rules. Signals are normalized signs (e.g. CHEST), button selections (CHOICE:MEDICAL) and gesture intents (INTENT:REQUEST_MEDICAL_HELP). Rules never diagnose: summaries repeat what was reported.",
  "categories": [
    "MEDICAL", "ROAD_ACCIDENT", "GENERAL_ACCIDENT", "FIRE", "POLICE_SAFETY", "ASSAULT", "FOLLOWING_STALKING",
    "TRAPPED", "DROWNING", "MISSING_PERSON", "LOST_STRANDED", "ELECTRICAL", "NATURAL_DISASTER", "GENERAL_HELP", "UNKNOWN"
  ],
  "category_labels": {
    "MEDICAL": "Medical help", "ROAD_ACCIDENT": "Road accident", "GENERAL_ACCIDENT": "Accident", "FIRE": "Fire",
    "POLICE_SAFETY": "Police or safety help", "ASSAULT": "Assault", "FOLLOWING_STALKING": "Being followed",
    "TRAPPED": "Someone trapped", "DROWNING": "Drowning", "MISSING_PERSON": "Missing person",
    "LOST_STRANDED": "Lost or stranded", "ELECTRICAL": "Electrical danger", "NATURAL_DISASTER": "Natural disaster",
    "GENERAL_HELP": "General help", "UNKNOWN": "Not clear yet"
  },
  "intent_categories": {
    "REQUEST_MEDICAL_HELP": "MEDICAL", "REQUEST_POLICE_HELP": "POLICE_SAFETY", "REQUEST_FIRE_ASSISTANCE": "FIRE",
    "REPORT_ACCIDENT": "GENERAL_ACCIDENT", "REPORT_UNSAFE_SITUATION": "POLICE_SAFETY",
    "REPORT_BEING_FOLLOWED": "FOLLOWING_STALKING", "REQUEST_RESCUE": "TRAPPED", "REPORT_MISSING_PERSON": "MISSING_PERSON",
    "REQUEST_GENERAL_HELP": "GENERAL_HELP", "CUSTOM_MESSAGE": "GENERAL_HELP"
  },
  "fact_phrases": {
    "CHEST": "chest", "PAIN": "pain", "BREATHING": "breathing", "DIFFICULT": "difficulty",
    "INJURY": "Injury reported.", "BLEEDING": "Bleeding reported.", "UNCONSCIOUS": "Someone is unconscious.",
    "SMOKE": "Smoke reported.", "TRAPPED": "Someone may be trapped.", "UNSAFE": "Feeling unsafe reported."
  },
  "body_parts": ["CHEST", "HEAD", "STOMACH", "BACK", "ARM", "LEG"],
  "rules": [
    {"id": "R-MED-CHEST-PAIN", "version": 1, "priority": 90, "all": ["CHEST", "PAIN"], "any": [], "none": [],
     "category": "MEDICAL", "alternatives": [], "summary": "You reported chest pain.",
     "missing": ["Who is affected", "Location"], "questions": ["WHO_AFFECTED", "ANYONE_UNCONSCIOUS", "LOCATION"]},
    {"id": "R-MED-BREATHING", "version": 1, "priority": 90, "all": ["BREATHING", "DIFFICULT"], "any": [], "none": [],
     "category": "MEDICAL", "alternatives": [], "summary": "You reported difficulty breathing.",
     "missing": ["Who is affected", "Location"], "questions": ["WHO_AFFECTED", "ANYONE_UNCONSCIOUS", "LOCATION"]},
    {"id": "R-MED-PAIN", "version": 1, "priority": 70, "all": ["PAIN"], "any": [], "none": [],
     "category": "MEDICAL", "alternatives": [], "summary": "You reported pain{body_part}.",
     "missing": ["Who is affected", "Location"], "questions": ["WHO_AFFECTED", "LOCATION"]},
    {"id": "R-MED-GENERAL", "version": 1, "priority": 60, "all": [],
     "any": ["SICK", "FEVER", "DOCTOR", "HOSPITAL", "MEDICINE", "PATIENT", "BLEEDING", "UNCONSCIOUS"], "none": [],
     "category": "MEDICAL", "alternatives": [], "summary": "You reported a health problem.",
     "missing": ["Who is affected", "Location"], "questions": ["WHO_AFFECTED", "LOCATION"]},
    {"id": "R-FIRE", "version": 1, "priority": 90, "all": [], "any": ["FIRE", "SMOKE"], "none": [],
     "category": "FIRE", "alternatives": [], "summary": "You reported fire or smoke.",
     "missing": ["Whether anyone is trapped", "Location"], "questions": ["PEOPLE_TRAPPED", "LOCATION"]},
    {"id": "R-FOLLOWED", "version": 1, "priority": 88, "all": ["FOLLOWING"], "any": ["PERSON", "UNSAFE"], "none": [],
     "category": "FOLLOWING_STALKING", "alternatives": ["POLICE_SAFETY"],
     "summary": "You reported being followed and feeling unsafe.",
     "missing": ["Immediate danger", "Location (only if safe)"], "questions": ["IMMEDIATE_DANGER", "LOCATION_SAFE"]},
    {"id": "R-ASSAULT", "version": 1, "priority": 86, "all": [], "any": ["ATTACK", "ASSAULT"], "none": [],
     "category": "ASSAULT", "alternatives": ["POLICE_SAFETY"], "summary": "You reported an attack or assault.",
     "missing": ["Immediate danger", "Location (only if safe)"], "questions": ["IMMEDIATE_DANGER", "LOCATION_SAFE"]},
    {"id": "R-UNSAFE", "version": 1, "priority": 75, "all": [], "any": ["UNSAFE", "THREAT", "POLICE", "GUN"], "none": [],
     "category": "POLICE_SAFETY", "alternatives": [], "summary": "You reported feeling unsafe.",
     "missing": ["Immediate danger", "Location (only if safe)"], "questions": ["IMMEDIATE_DANGER", "LOCATION_SAFE"]},
    {"id": "R-ROAD-ACCIDENT", "version": 1, "priority": 85, "all": ["ACCIDENT"],
     "any": ["CAR", "STREET_OR_ROAD", "ROAD", "BUS", "TRUCK", "BICYCLE", "VEHICLE"], "none": [],
     "category": "ROAD_ACCIDENT", "alternatives": [], "summary": "You reported a road accident.",
     "missing": ["Whether anyone is injured", "Location"], "questions": ["ANYONE_INJURED", "LOCATION"]},
    {"id": "R-ACCIDENT", "version": 1, "priority": 80, "all": ["ACCIDENT"], "any": [], "none": [],
     "category": "GENERAL_ACCIDENT", "alternatives": ["ROAD_ACCIDENT"], "summary": "You reported an accident.",
     "missing": ["Whether anyone is injured", "Location"], "questions": ["ANYONE_INJURED", "LOCATION"]},
    {"id": "R-TRAPPED", "version": 1, "priority": 84, "all": [], "any": ["TRAPPED", "STUCK"], "none": [],
     "category": "TRAPPED", "alternatives": [], "summary": "You reported that someone is trapped.",
     "missing": ["Location"], "questions": ["LOCATION"]},
    {"id": "R-DROWNING", "version": 1, "priority": 92, "all": [], "any": ["DROWNING"], "none": [],
     "category": "DROWNING", "alternatives": [], "summary": "You reported someone drowning.",
     "missing": ["Location"], "questions": ["LOCATION"]},
    {"id": "R-MISSING", "version": 1, "priority": 70, "all": ["MISSING"], "any": [], "none": [],
     "category": "MISSING_PERSON", "alternatives": [], "summary": "You reported a missing person.",
     "missing": ["Location last seen"], "questions": ["LOCATION"]},
    {"id": "R-LOST", "version": 1, "priority": 60, "all": [], "any": ["LOST", "STRANDED"], "none": ["MISSING"],
     "category": "LOST_STRANDED", "alternatives": [], "summary": "You reported being lost or stranded.",
     "missing": ["Location"], "questions": ["LOCATION"]},
    {"id": "R-ELECTRICAL", "version": 1, "priority": 82, "all": [], "any": ["ELECTRIC_SHOCK", "ELECTRICITY", "WIRE"], "none": [],
     "category": "ELECTRICAL", "alternatives": [], "summary": "You reported an electrical danger.",
     "missing": ["Location"], "questions": ["ANYONE_INJURED", "LOCATION"]},
    {"id": "R-DISASTER", "version": 1, "priority": 82, "all": [], "any": ["EARTHQUAKE", "FLOOD", "CYCLONE", "LANDSLIDE"], "none": [],
     "category": "NATURAL_DISASTER", "alternatives": [], "summary": "You reported a natural disaster.",
     "missing": ["Location"], "questions": ["PEOPLE_TRAPPED", "LOCATION"]},
    {"id": "R-HELP-ONLY", "version": 1, "priority": 10, "all": ["HELP"], "any": [], "none": [],
     "category": "GENERAL_HELP", "alternatives": ["UNKNOWN"], "summary": "You asked for help.",
     "missing": ["What kind of help"], "questions": ["HELP_TYPE"]}
  ]
}
